# Supabase — see supabase/README.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS. Never prefix with NEXT_PUBLIC_, never import outside
# lib/supabase/service.ts. See docs/database-schema.md for what it's scoped to.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for sitemap.xml / robots.txt / canonical links
NEXT_PUBLIC_SITE_URL=https://pokaranlab.com

# SMS gateway (Msg91 or Fast2SMS) — wired in Phase 2, see docs/system-design.md §9
SMS_API_KEY=
